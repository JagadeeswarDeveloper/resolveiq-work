# ResolveIQ Environment Configuration

# Database
DATABASE_URL=postgresql://resolveiq:resolveiq_dev@postgres:5432/resolveiq
SQLALCHEMY_ECHO=true

# Redis
REDIS_URL=redis://redis:6379/0

# LLM Configuration
# Provider: ollama (default), openai, or fallback
LLM_PROVIDER=ollama
LLM_MODEL=neural-chat
AI_MODE=live

# Ollama Configuration (for local development)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI API (if using OpenAI provider)
OPENAI_API_KEY=

# Embeddings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Vector Store
VECTOR_STORE=pgvector

# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production
LOG_LEVEL=INFO

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Features
ENABLE_DEMO_MODE=true
MAX_COMPLAINTS_PER_DAY=1000
